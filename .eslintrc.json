{
  "env": {
    "browser": true,
    "es2021": true,
    "node": true
  },
  "extends": [
    "eslint:recommended"
  ],
  "plugins": ["html"],
  "parserOptions": {
    "ecmaVersion": "latest",
    "sourceType": "module"
  },
  "rules": {
    "no-console": "off",
    "no-unused-vars": "warn"
  },
  "settings": {
    "html/html-extensions": [".html"]
  },
  "ignorePatterns": [
    "node_modules/",
    "backend/node_modules/",
    "frontend/node_modules/",
    ".github/",
    "package-lock.json"
  ]
}
